<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="hakomonitor"
  author="wandercone"
  version="2026.05.28"
  launch="Settings/HakoMonitor"
  pluginURL="https://raw.githubusercontent.com/wandercone/HakoMonitor/main/plugin/hakomonitor.plg"
  support="https://forums.unraid.net/topic/198214-plugin-hakomonitor/"
  
  
  icon="heartbeat"
>

<CHANGES>
<![CDATA[

### 2026.05.28

fix: turns out unraid emhttp requires csrf when working with forms

### 2026.05.24.01

fix: remove CSRF because it keeps causing issues

### 2026.04.10.04

- chore: maybe it was correct before...
- chore: fix pluginurl...again


For older releases, see https://github.com/wandercone/HakoMonitor/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakomonitor/unraid-hakomonitor-2026.05.28-noarch-1.txz">
<URL>https://github.com/wandercone/HakoMonitor/releases/download/2026.05.28/unraid-hakomonitor-2026.05.28-noarch-1.txz</URL>
<SHA256>7b8f8a00333032f41cfff487950ed015aacc25d7c60b2b76f89aebb1da4fd5b2</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakomonitor/unraid-hakomonitor-2026.05.28-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakomonitor/unraid-hakomonitor-*.txz 2>/dev/null | grep -v '2026.05.28')

echo ""
echo "----------------------------------------------------"
echo " hakomonitor has been installed."
echo " Version: 2026.05.28"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-hakomonitor

rm -rf /usr/local/emhttp/plugins/hakomonitor
rm -rf /boot/config/plugins/hakomonitor
]]>
</INLINE>
</FILE>

</PLUGIN>
