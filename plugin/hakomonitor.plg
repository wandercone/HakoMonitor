]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakomonitor/unraid-hakomonitor-2026.05.24.01-noarch-1.txz">
<URL>https://github.com/wandercone/HakoMonitor/releases/download/2026.05.24.01/unraid-hakomonitor-2026.05.24.01-noarch-1.txz</URL>
<SHA256>0232ef30753483bdd0f013ff487ceeae67a4206e5d08108e2c86d2bd6ffe8b8c</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakomonitor/unraid-hakomonitor-2026.05.24.01-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakomonitor/unraid-hakomonitor-*.txz 2>/dev/null | grep -v '2026.05.24.01')

echo ""
echo "----------------------------------------------------"
echo " hakomonitor has been installed."
echo " Version: 2026.05.24.01"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-hakomonitor

rm -rf /usr/local/emhttp/plugins/hakomonitor
rm -rf /boot/config/plugins/hakomonitor
]]>
</INLINE>
</FILE>

</PLUGIN>
